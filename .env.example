GATEWAY_ENVIRONMENT=development
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8320
GATEWAY_LOG_LEVEL=INFO
GATEWAY_LOG_FORMAT=json
GATEWAY_REQUEST_ID_HEADER=x-request-id
GATEWAY_TRUST_INCOMING_REQUEST_ID=false
# Required when PostgreSQL-backed configuration is enabled.
GATEWAY_DATABASE_URL=
GATEWAY_CONFIG_REFRESH_SECONDS=5
GATEWAY_REQUEST_TIMEOUT_SECONDS=600
GATEWAY_FIRST_EVENT_TIMEOUT_SECONDS=60
# Required when loading a published runtime snapshot from PostgreSQL.
# Generate independent 32-byte values and base64 encode them.
GATEWAY_CREDENTIAL_ENCRYPTION_KEY=
GATEWAY_KEY_PEPPER=
GATEWAY_SUPABASE_URL=
GATEWAY_SUPABASE_JWT_AUDIENCE=authenticated
GATEWAY_ADMIN_ROLE=admin

# Route upstream provider traffic through a proxy. Some provider edges challenge on
# the caller's source IP, so a datacenter egress range can be refused regardless of
# what the request looks like. socks5h is preferred so DNS is resolved at the proxy
# and upstream hostname lookups do not leak from this host. Leave blank to go direct.
GATEWAY_UPSTREAM_PROXY_URL=
# Only set this to false for a proxy doing TLS interception you control.
GATEWAY_UPSTREAM_PROXY_VERIFY_TLS=true
